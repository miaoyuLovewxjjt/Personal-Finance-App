# 签名配置示例：复制本文件为 keystore.properties 并填入真实口令。
#
# keystore.properties 已在 .gitignore 中，不会入库。
# 若本文件不存在或口令为空，构建不会失败：
#   - assembleDebug   使用系统 debug 签名（~/.android/debug.keystore，AGP 自动生成）
#   - assembleRelease 产出未签名包 app-release-unsigned.apk
#
# 也支持用 gradle 属性（~/.gradle/gradle.properties）或环境变量覆盖：
#   PIXELBOOK_STORE_PASSWORD / PIXELBOOK_KEY_PASSWORD / PIXELBOOK_KEY_ALIAS

# keystore 文件固定放在 keystore/pixelbook.keystore（可用下面的路径覆盖，相对项目根目录）
# keystorePath=keystore/pixelbook.keystore

pixelbookStorePassword=
pixelbookKeyPassword=
pixelbookKeyAlias=pixelbook
